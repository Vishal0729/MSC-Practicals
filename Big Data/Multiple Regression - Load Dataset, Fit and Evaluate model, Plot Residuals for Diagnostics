
# Multiple Regression Model

## Python

```python
# ===== Step 1: Load packages =====
import pandas as pd
import numpy as np
from sklearn.linear_model import LinearRegression
from sklearn.model_selection import train_test_split
from sklearn.metrics import r2_score, mean_squared_error, mean_absolute_error
import matplotlib.pyplot as plt

# ===== Step 2: Load Dataset & Fit Model (5 Marks) =====
url = "https://raw.githubusercontent.com/selva86/datasets/master/BostonHousing.csv"
df = pd.read_csv(url)

# --- If file is downloaded locally: ---
# df = pd.read_csv("BostonHousing.csv")
# ---------------------------------------

print("Dataset: Boston Housing")
print(f"Shape: {df.shape}")
print(f"\nTarget: medv (Median House Price)")
print(f"Features: {list(df.columns[:-1])}")

# Prepare features and target
X = df.drop(columns=['medv'])
y = df['medv']

# Split data
X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.3, random_state=42)
print(f"\nTrain: {len(X_train)}, Test: {len(X_test)}")

# Fit Multiple Regression Model
model = LinearRegression()
model.fit(X_train, y_train)
print("\nMultiple Regression Model fitted!")

# Coefficients
print("\nCoefficients:")
for name, coef in zip(X.columns, model.coef_):
    print(f"  {name:<10}: {coef:.4f}")
print(f"  {'Intercept':<10}: {model.intercept_:.4f}")

# ===== Step 3: Evaluate Model (5 Marks) =====
y_pred_train = model.predict(X_train)
y_pred_test = model.predict(X_test)

r2_train = r2_score(y_train, y_pred_train)
r2_test = r2_score(y_test, y_pred_test)
rmse = np.sqrt(mean_squared_error(y_test, y_pred_test))
mae = mean_absolute_error(y_test, y_pred_test)

print(f"\n{'='*50}")
print(f"  MODEL EVALUATION")
print(f"{'='*50}")
print(f"  R² (Train):  {r2_train:.4f}")
print(f"  R² (Test):   {r2_test:.4f}")
print(f"  RMSE:        {rmse:.4f}")
print(f"  MAE:         {mae:.4f}")
print(f"  Model Fit:   {'GOOD' if r2_test > 0.6 else 'POOR'}")
print(f"  Overfitting: {'YES' if (r2_train - r2_test) > 0.1 else 'NO'}")

# ===== Step 4: Plot Residuals for Diagnostics (5 Marks) =====
residuals = y_test - y_pred_test

fig, axes = plt.subplots(2, 2, figsize=(10, 8))

# Plot 1: Residuals vs Predicted
axes[0, 0].scatter(y_pred_test, residuals, alpha=0.6, color='blue', edgecolors='k')
axes[0, 0].axhline(y=0, color='red', linestyle='--', lw=2)
axes[0, 0].set_xlabel("Predicted Values")
axes[0, 0].set_ylabel("Residuals")
axes[0, 0].set_title("Residuals vs Predicted")
axes[0, 0].grid(True, alpha=0.3)

# Plot 2: Actual vs Predicted
axes[0, 1].scatter(y_test, y_pred_test, alpha=0.6, color='green', edgecolors='k')
axes[0, 1].plot([y_test.min(), y_test.max()], [y_test.min(), y_test.max()], 'r--', lw=2)
axes[0, 1].set_xlabel("Actual Values")
axes[0, 1].set_ylabel("Predicted Values")
axes[0, 1].set_title(f"Actual vs Predicted (R²={r2_test:.4f})")
axes[0, 1].grid(True, alpha=0.3)

# Plot 3: Histogram of Residuals (Normality check)
axes[1, 0].hist(residuals, bins=20, color='orange', edgecolor='black', alpha=0.7)
axes[1, 0].axvline(x=0, color='red', linestyle='--', lw=2)
axes[1, 0].set_xlabel("Residuals")
axes[1, 0].set_ylabel("Frequency")
axes[1, 0].set_title("Residual Distribution (Should be Normal)")

# Plot 4: QQ Plot (Normality check)
from scipy import stats
stats.probplot(residuals, plot=axes[1, 1])
axes[1, 1].set_title("Q-Q Plot (Normality Check)")
axes[1, 1].grid(True, alpha=0.3)

plt.suptitle("Residual Diagnostics - Multiple Regression", fontsize=14)
plt.tight_layout()
plt.savefig("residual_diagnostics.png")
plt.show()

# Diagnostics Summary
print(f"\nResidual Diagnostics:")
print(f"  Mean of Residuals: {residuals.mean():.4f} (should be ~0)")
print(f"  Std of Residuals:  {residuals.std():.4f}")
print(f"  Normality (Shapiro): p={stats.shapiro(residuals[:50])[1]:.4f}")
```

