## R

```r
# ===== Step 1: Load Dataset & Fit Model (5 Marks) =====
url <- "https://raw.githubusercontent.com/selva86/datasets/master/BostonHousing.csv"
df <- read.csv(url)

# --- If file is downloaded locally: ---
# df <- read.csv("BostonHousing.csv")
# ---------------------------------------

cat("Dataset: Boston Housing\n")
cat(sprintf("Shape: %d rows, %d columns\n", nrow(df), ncol(df)))
cat(sprintf("Target: medv (Median House Price)\n"))

# Split data
set.seed(42)
train_idx <- sample(1:nrow(df), 0.7 * nrow(df))
train_data <- df[train_idx, ]
test_data <- df[-train_idx, ]
cat(sprintf("\nTrain: %d, Test: %d\n", nrow(train_data), nrow(test_data)))

# Fit Multiple Regression Model (medv ~ all other variables)
model <- lm(medv ~ ., data = train_data)
cat("\nMultiple Regression Model fitted!\n")

# Coefficients
cat("\nCoefficients:\n")
print(round(coef(model), 4))

# ===== Step 2: Evaluate Model (5 Marks) =====
y_pred_train <- predict(model, train_data)
y_pred_test <- predict(model, test_data)
y_test <- test_data$medv

# Metrics
r2_train <- summary(model)$r.squared
ss_res <- sum((y_test - y_pred_test)^2)
ss_tot <- sum((y_test - mean(y_test))^2)
r2_test <- 1 - (ss_res / ss_tot)
rmse <- sqrt(mean((y_test - y_pred_test)^2))
mae <- mean(abs(y_test - y_pred_test))

cat(sprintf("\n%s\n", strrep("=", 50)))
cat("  MODEL EVALUATION\n")
cat(sprintf("%s\n", strrep("=", 50)))
cat(sprintf("  R² (Train):  %.4f\n", r2_train))
cat(sprintf("  R² (Test):   %.4f\n", r2_test))
cat(sprintf("  RMSE:        %.4f\n", rmse))
cat(sprintf("  MAE:         %.4f\n", mae))
cat(sprintf("  Model Fit:   %s\n", ifelse(r2_test > 0.6, "GOOD", "POOR")))
cat(sprintf("  Overfitting: %s\n", ifelse((r2_train - r2_test) > 0.1, "YES", "NO")))

# F-statistic significance
f_stat <- summary(model)$fstatistic
p_value <- pf(f_stat[1], f_stat[2], f_stat[3], lower.tail = FALSE)
cat(sprintf("  F-statistic: %.2f (p-value: %.2e)\n", f_stat[1], p_value))

# ===== Step 3: Plot Residuals for Diagnostics (5 Marks) =====
residuals <- y_test - y_pred_test

par(mfrow = c(2, 2))

# Plot 1: Residuals vs Predicted
plot(y_pred_test, residuals, pch = 16, col = "blue",
     xlab = "Predicted Values", ylab = "Residuals",
     main = "Residuals vs Predicted")
abline(h = 0, col = "red", lwd = 2, lty = 2)
grid()

# Plot 2: Actual vs Predicted
plot(y_test, y_pred_test, pch = 16, col = "green",
     xlab = "Actual Values", ylab = "Predicted Values",
     main = sprintf("Actual vs Predicted (R²=%.4f)", r2_test))
abline(0, 1, col = "red", lwd = 2, lty = 2)
grid()

# Plot 3: Histogram of Residuals
hist(residuals, breaks = 20, col = "orange", border = "black",
     main = "Residual Distribution", xlab = "Residuals")
abline(v = 0, col = "red", lwd = 2, lty = 2)

# Plot 4: QQ Plot
qqnorm(residuals, pch = 16, col = "purple", main = "Q-Q Plot (Normality Check)")
qqline(residuals, col = "red", lwd = 2)

par(mfrow = c(1, 1))

# Diagnostics Summary
cat(sprintf("\nResidual Diagnostics:\n"))
cat(sprintf("  Mean of Residuals: %.4f (should be ~0)\n", mean(residuals)))
cat(sprintf("  Std of Residuals:  %.4f\n", sd(residuals)))
shapiro_p <- shapiro.test(residuals[1:50])$p.value
cat(sprintf("  Normality (Shapiro p-value): %.4f\n", shapiro_p))
cat(sprintf("  Normal: %s (p > 0.05)\n", ifelse(shapiro_p > 0.05, "YES", "NO")))
```

